// Vivaha Cards ERP — physical data model.
// Derived from the client-approved interactive mock (docs/reference/vivaha-erp-mockup.html).
// Stock movements, ledger entries and audit rows are append-only: corrections are
// reversing entries, never edits.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Users, RBAC, Audit ─────────────────────────

enum Role {
  SUPER_ADMIN
  PURCHASE_MANAGER
  SALES_EXECUTIVE
  GODOWN_MANAGER
  DISPATCH_MANAGER
  ACCOUNTS_MANAGER
  CUSTOMER
}

// Goods arrive carrying the manufacturer's own QR label. The office re-labels
// them with its own code, but the manufacturer code is never destroyed: a scan
// of the old label still resolves, so a vendor claim or a recall can always be
// traced back. One item has many codes; exactly one of them is ACTIVE + OWN.
enum CodeKind {
  MANUFACTURER
  OWN
}

enum CodeStatus {
  ACTIVE
  REPLACED
}

model ItemCode {
  id           String     @id @default(cuid())
  code         String     @unique
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind         CodeKind
  status       CodeStatus @default(ACTIVE)
  vendorId     String?
  vendor       Vendor?    @relation(fields: [vendorId], references: [id])
  note         String?
  replacedById String?    @unique
  replacedBy   ItemCode?  @relation("Replacement", fields: [replacedById], references: [id])
  replaces     ItemCode?  @relation("Replacement")
  by           String
  createdAt    DateTime   @default(now())
  replacedAt   DateTime?

  @@index([itemId, status])
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  passwordHash     String
  name             String
  initials         String
  role             Role
  isActive         Boolean   @default(true)
  customerId       String?   // set only for CUSTOMER (portal) logins
  customer         Customer? @relation(fields: [customerId], references: [id])
  authority        String?   // Owner | Staff — portal contact authority
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  // Set when the office issues or resets a password. The holder is forced to
  // replace it before the session can be used for anything else.
  mustChangePassword Boolean @default(false)
  passwordSetAt      DateTime?
  lastLoginAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs         AuditLog[]
  grants            UserPermission[]
  contact           CustomerContact?
  notifications     Notification[]
  notificationReads NotificationRead[]
  salesCustomers    Customer[]         @relation("CustomerSalesExec")
}

// A capability given to, or withheld from, one person — on top of whatever the
// role they hold already carries.
//
// A role answers "what does an accounts manager do". It cannot answer "Rahin,
// and only Rahin, may correct a bill" — and that is the question the office
// actually asks, because the person trusted with a correction is a person, not
// a job title. Widening the whole role to let one person do one thing is how
// everybody ends up able to do everything.
//
// `allow = false` is a withholding rather than an absence: it takes a
// capability off one person while their role keeps it, which is the other half
// of the same question and is recorded with the same trail.
model UserPermission {
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  perm   String
  allow  Boolean @default(true)
  by     String
  reason String   @default("")
  at     DateTime @default(now())

  @@id([userId, perm])
}

// Permissions are data, not code — Settings → Roles & permissions.
model RolePermission {
  role Role
  perm String

  @@id([role, perm])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  actor      String
  action     String
  entityType String
  entityId   String
  oldValue   String   @default("")
  newValue   String   @default("")
  reason     String   @default("")
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

enum NotifKind {
  INFO
  OK
  WARN
  ERR
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  role      Role?     // broadcast to a role when userId is null
  kind      NotifKind @default(INFO)
  text      String
  link      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  reads     NotificationRead[]

  @@index([userId, isRead])
  @@index([role, createdAt])
}

model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
}

// Gapless document numbering per series (INV, CN, ORD, PO, TRF, RET, RCPT, JOB).
model Sequence {
  name  String @id
  value Int    @default(0)
}

model Setting {
  key   String @id
  value Json
}

// ───────────────────────── Masters ─────────────────────────

enum PricingModel {
  SLAB
  AREA
  QUOTE
}

enum LineWorkflow {
  FULFIL
  JOBWORK
}

model BusinessLine {
  id           String       @id // L1, L2, ...
  code         String       @unique
  name         String
  nameHi       String
  icon         String
  color        String
  bg           String
  uom          String
  packUoms     Json         @default("[]")
  minSetQty    Int          @default(0)
  holdMins     Int          @default(30)
  gstPct       Int
  stockDims    Json         @default("[]")
  batchTracked Boolean      @default(false)
  pricingModel PricingModel @default(SLAB)
  workflow     LineWorkflow @default(FULFIL)
  facets       Json         @default("[]")
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)
  // Whether a firm can be given its own price on this line. True everywhere:
  // a card list being fixed is about the year it runs for, not about whether a
  // dealer can be given a rate — see priceListAnnual.
  allowCustomPricing Boolean @default(true)
  // The list on this line is the manufacturer's, published once and standing
  // for the whole financial year. Changing a rate inside that year is a
  // revision of a published list, not an ordinary edit, and is recorded as one.
  priceListAnnual    Boolean @default(false)
  // Each line bills on its own series, so a flex invoice and a card invoice are
  // never the same number. The prefix and the number to start from are set in
  // Settings; the series itself restarts every financial year.
  invoicePrefix      String  @default("VC")
  invoiceStart       Int     @default(1)

  items      Item[]
  attributes AttributeDef[]
  orderLines OrderLine[]
  invoices   Invoice[]
  ads        Ad[]
}

// "Or any other" / "future option to add more fields" — every classification
// is an admin-editable master.
model AttributeDef {
  id          String        @id @default(cuid())
  lineId      String?       // null = customer-level attribute
  line        BusinessLine? @relation(fields: [lineId], references: [id])
  key         String
  label       String
  values      Json          @default("[]")
  multiSelect Boolean       @default(false)
  portalFacet Boolean       @default(false)
  sortOrder   Int           @default(0)

  @@unique([lineId, key])
}

model Godown {
  id       String  @id // GD-A
  name     String
  short    String
  manager  String
  address  String
  isActive Boolean @default(true)

  racks     Rack[]
  balances  StockBalance[]
  txns      StockTxn[]
  transfersFrom Transfer[] @relation("TransferFrom")
  transfersTo   Transfer[] @relation("TransferTo")
}

// A rack is a place inside a godown — the shelf a bundle is actually put on.
//
// Until now the office ran one "godown" per rack, because a rack had nowhere
// else to live. That made a building and a shelf the same kind of thing: stock
// could be transferred between racks as if they were separate premises, and
// the dispatch screen listed twenty "godowns" that were all the same room.
//
// A godown is a building; a rack is where inside it the goods sit. Stock is
// counted and reserved per godown — that is the number the order screen asks
// about — and the rack rides along on each balance row so the picker is told
// where to go. "-" is the rack of stock that was put away before anybody wrote
// a rack down, and of a godown that does not use them.
model Rack {
  id        String  @id @default(cuid())
  godownId  String
  godown    Godown  @relation(fields: [godownId], references: [id], onDelete: Cascade)
  code      String  // "R-1", "A-03"
  name      String  @default("") // "Near the door", "Top shelf"
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  subRacks  SubRack[]

  @@unique([godownId, code])
}

// A shelf, bay or tier inside a rack. One rack holds several.
//
// It is a master rather than a column because the numbering is the firm's own —
// A/B/C on one rack, 1/2/3 on the next — and typing it free-hand at every
// receipt is how the same shelf ends up written four ways.
//
// Stock itself is not keyed by this. StockBalance.rack holds the whole location
// as one code — "R-1" for a rack with no shelves, "R-1/A" for one with — so the
// engine that holds, reserves and ships stock did not have to learn a third
// level of geography to say where a bundle is.
model SubRack {
  id        String  @id @default(cuid())
  rackId    String
  rack      Rack    @relation(fields: [rackId], references: [id], onDelete: Cascade)
  code      String  // "A", "2", "Top"
  name      String  @default("")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@unique([rackId, code])
}

model Vendor {
  id     String @id // VND-01
  // The supplier's number in the office's own books — the same idea as a
  // customer's. VND-01 is the system's key; this is the word the counter uses,
  // and both are searchable by it.
  code   String? @unique
  name   String
  gstin  String?
  terms  String
  city   String
  phone  String
  // Where a customer can be pointed to pay this supplier directly. Held on the
  // supplier because it is theirs, and shown only to the person at the counter
  // who is taking the payment.
  upiId  String?
  items       Item[]
  purchases   Purchase[]
  payments    VendorPayment[]
  itemCodes   ItemCode[]
  settlements Settlement[]
}

model PricingGroup {
  name       String  @id
  multiplier Decimal @db.Decimal(6, 3)
}

enum ItemStatus {
  ACTIVE
  DISCONTINUED
}

model Item {
  id           String       @id // ITM-101
  sku          String       @unique
  designNo     String?
  name         String
  nameHi       String
  lineId       String
  line         BusinessLine @relation(fields: [lineId], references: [id])
  attrs        Json         @default("{}")
  uom          String
  packUom      String       @default("")
  perPack      Int          @default(1)
  moq          Int          @default(1)
  landedCost   Decimal      @db.Decimal(12, 2)
  // What the supplier charges for it, before freight — the figure on their
  // invoice, not the weighted average landed cost. The office prices off this,
  // because it is the number they negotiate and the one they remember; landed
  // cost is what the margin floor is measured against and moves on its own with
  // every receipt. Kept in step automatically at goods receipt.
  purchasePrice Decimal?    @db.Decimal(12, 2)
  // This item's own markup, replacing the buying firm's group multiplier.
  // Null is the normal case: the firm's group decides. Set it when a design
  // sells at a fixed markup whoever is buying — an exclusive block, a licensed
  // motif — which otherwise meant a per-item override on every firm, one at a
  // time, and a new one every time a customer was added.
  multiplier   Decimal?     @db.Decimal(6, 3)
  hsn          String
  gstPct       Int
  vendorId     String?
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  status       ItemStatus   @default(ACTIVE)
  season       String?
  batchTracked Boolean      @default(false)
  wastagePct   Decimal?     @db.Decimal(5, 2)
  setupCharge  Decimal?     @db.Decimal(12, 2)
  artSeed      Int          @default(0)
  imageUrl     String?
  // The financial year the current slabs belong to, stamped whenever they are
  // set. On an annual line this is what tells a new year's list apart from a
  // mid-year revision of the standing one.
  priceListFy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  codes         ItemCode[]
  images        ItemImage[]
  slabs         PriceSlab[]
  priceHistory  ItemPriceHistory[]
  balances      StockBalance[]
  txns          StockTxn[]
  overrides     PriceOverride[]
  purchaseLines PurchaseLine[]
  transfers     Transfer[]
  orderLines    OrderLine[]
  returns       ReturnRequest[]
  jobsBase      JobWork[]       @relation("JobBase")
  jobsProcess   JobWork[]       @relation("JobProcess")
  stockoutHits  StockoutSearch[]
  kitItems      KitVersionItem[]
  ads           Ad[]
  priceChanges  PriceChange[]
}

// A wedding card is not one picture. It opens: a double fold has a front and an
// inside, a trifold has three panels, a pocket card has the pocket and the
// insert — and a buyer chooses on the inside artwork as much as the cover. One
// row per page, ordered the way the card opens.
//
// Item.imageUrl stays as the cover and is kept in step with the first page, so
// every list, drawer and catalogue tile that already reads it carries on
// working without knowing the gallery exists.
model ItemImage {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  label     String   @default("")  // "Front", "Inside", "Back", "Pocket"…
  sortOrder Int      @default(0)
  by        String   @default("")
  at        DateTime @default(now())

  @@index([itemId, sortOrder])
}

// A price change with a date it starts on.
//
// A price list is agreed in advance — "from the first of next month" — and the
// office should be able to key it when it is agreed rather than remember to do
// it on the morning. Until that date arrives the item keeps the rates it has,
// so every order in between is priced on what was actually published.
//
// It is applied by a sweeper rather than read at quote time on purpose: once
// applied, the item's own rates are the truth, exactly as if somebody had typed
// them that morning, and every screen and report that already reads slabs keeps
// working without learning what a pending change is.
model PriceChange {
  id            String    @id @default(cuid())
  itemId        String
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  purchasePrice Decimal?  @db.Decimal(12, 2)
  multiplier    Decimal?  @db.Decimal(6, 3)
  slabs         Json      @default("[]") // [{ fromQty, toQty, rate }]
  status        String    @default("PENDING") // PENDING | APPLIED | CANCELLED
  reason        String    @default("")
  by            String
  createdAt     DateTime  @default(now())
  appliedAt     DateTime?

  @@index([status, effectiveFrom])
  @@index([itemId, effectiveFrom])
}

// Every movement of an item's price list, so "why is this dearer than last
// season" has an answer. Written by the item update path, never by hand.
model ItemPriceHistory {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  field      String   // "slab1" | "landedCost"
  oldValue   Decimal  @db.Decimal(12, 2)
  newValue   Decimal  @db.Decimal(12, 2)
  reason     String   @default("")
  by         String
  at         DateTime @default(now())

  @@index([itemId, at])
}

model PriceSlab {
  id      String  @id @default(cuid())
  itemId  String
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromQty Int
  toQty   Int
  rate    Decimal @db.Decimal(12, 2)

  @@index([itemId, fromQty])
}

// ───────────────────────── Customers ─────────────────────────

enum GateMode {
  WARN
  BLOCK
}

model Customer {
  id           String   @id // CUST-101
  // The number the firm has always been known by in the office's own books —
  // a khata number, a ledger folio, whatever was written on the bahi. CUST-101
  // is the system's key and nobody at the counter thinks in it; this is what
  // they say out loud, so it is searchable and shown beside the name.
  code         String?  @unique
  name         String
  contactName  String
  group        String   // PricingGroup.name
  tehsil       String
  creditLimit  Decimal  @db.Decimal(14, 2)
  creditDays   Int      @default(0)
  gateMode     GateMode @default(WARN)
  gstin        String?
  firmType     String   @default("Registered")
  phone        String
  address      String   @default("")
  linesEnabled Json     @default("[]")
  referCode    String   @unique
  // Firm-wide percentage off the group rate, applied to everything they buy
  // unless a per-item override says otherwise.
  priceAdjPct  Decimal  @default(0) @db.Decimal(5, 2)
  // The latest fix, whatever produced it — kept here so every screen that shows
  // "last known" reads one row. CustomerLocation holds the trail. Nullable
  // throughout: permission is often refused, and a firm without a pin is still
  // a firm.
  lat          Float?
  lng          Float?
  geoAccuracy  Float?
  geoAt        DateTime?
  salesExecId  String?
  salesExec    User?    @relation("CustomerSalesExec", fields: [salesExecId], references: [id])
  status       String   @default("Active")
  blockReason  String?
  blockedBy    String?
  blockedAt    DateTime?
  blockUntil   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts   CustomerContact[]
  locations  CustomerLocation[]
  machines   CustomerMachine[]
  overrides  PriceOverride[]
  users      User[]
  orders     Order[]
  ledger     LedgerEntry[]
  payments   Payment[]
  settlements Settlement[]
  invoices   Invoice[]
  returns    ReturnRequest[]
  jobs       JobWork[]
  kit        Kit?
  cart       Cart?
  referrals  Referral[]
  referredBy Referral?     @relation("ReferredCustomer")
  recoveries CartRecovery[]
  stockoutHits StockoutSearch[]
}

// Where a firm has actually been seen, one row per fix. Two questions need
// answering and they are not the same: where the shop was when it was
// onboarded, and where the firm was the last time it used the portal. Customer
// keeps the latest fix denormalised so every screen that shows "last known"
// reads one row.
//
// Discrete fixes only — a fix is written when someone onboards a firm, edits it
// from the office, or the firm checks in. Never a background watch.
enum GeoSource {
  ONBOARDING
  OFFICE_EDIT
  PORTAL_CHECKIN
}

model CustomerLocation {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float?
  source     GeoSource
  by         String    @default("")
  at         DateTime  @default(now())

  @@index([customerId, at])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String
  phone      String
  hasLogin   Boolean  @default(false)
  authority  String   @default("Staff")
  // Bills go to the numbers marked here. A firm can mark more than one — the
  // owner and whoever keeps the accounts is the common case — and the share
  // dialog offers them first. Seeded true for the owner of every firm.
  billsTo    Boolean  @default(false)
  // The portal login issued against this person, when there is one. hasLogin
  // was the only marker before, set by matching on name, which broke as soon
  // as two people at a firm shared a first name or one of them was renamed.
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CustomerMachine {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String
  spec       Json     @default("{}")
}

enum PriceMode {
  FLAT
  PERCENT
}

model PriceOverride {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  rate       Decimal  @db.Decimal(12, 2)
  // FLAT keeps `rate` as the agreed price. PERCENT holds a discount in `pct`
  // and lets `rate` follow the slab, so a negotiated 8% does not silently
  // become a frozen rupee figure the next time the price list moves.
  mode       PriceMode @default(FLAT)
  pct        Decimal?  @db.Decimal(5, 2)
  reason     String   @default("")
  setBy      String
  createdAt  DateTime @default(now())

  @@id([customerId, itemId])
}

// ───────────────────────── Stock ─────────────────────────

// One row per item × godown × batch. Five buckets; availability is computed.
model StockBalance {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  godownId    String
  godown      Godown    @relation(fields: [godownId], references: [id])
  // Where inside the godown. "-" means nobody recorded a rack.
  rack        String    @default("-")
  batchNo     String    @default("-")
  expiry      DateTime?
  // When this pile was first put away, so first-in-first-out has something to
  // sort on. Set on the first receipt into the row and never moved after.
  firstIn     DateTime?
  onHand      Int       @default(0)
  reserved    Int       @default(0)
  hold        Int       @default(0)
  damaged     Int       @default(0)
  quarantined Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([itemId, godownId, rack, batchNo])
  @@index([itemId])
}

enum StockTxnType {
  GRN
  HOLD
  HOLD_RELEASE
  RESERVE
  RESERVE_RELEASE
  DISPATCH
  TRANSFER_OUT
  TRANSFER_IN
  DAMAGE
  QUARANTINE
  RECOVER
  WRITE_OFF
  RETURN_IN
  JOB_ISSUE
}

model StockTxn {
  id       String       @id @default(cuid())
  type     StockTxnType
  itemId   String
  item     Item         @relation(fields: [itemId], references: [id])
  godownId String
  godown   Godown       @relation(fields: [godownId], references: [id])
  rack     String?
  batchNo  String?
  qty      Int
  ref      String?
  reason   String?
  by       String
  at       DateTime     @default(now())

  @@index([itemId, at])
  @@index([ref])
}

enum PurchaseStatus {
  IN_TRANSIT
  POSTED
}

model Purchase {
  id       String         @id // PO-4180
  vendorId String
  vendor   Vendor         @relation(fields: [vendorId], references: [id])
  invNo    String
  date     DateTime
  eta      DateTime?
  freight  Decimal        @default(0) @db.Decimal(12, 2)
  total    Decimal        @db.Decimal(14, 2)
  gstPct   Int
  status   PurchaseStatus @default(POSTED)
  by       String
  lines    PurchaseLine[]

  @@index([vendorId, date])
}

model PurchaseLine {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  qty        Int
  rate       Decimal  @db.Decimal(12, 2)
  alloc      Json     @default("{}") // { godownId: qty } — the godown roll-up
  // Where the goods were actually put: [{ godownId, rack, qty }]. `alloc` is
  // this summed per godown and stays the field every screen and the stock
  // engine read, so a receipt booked before racks existed still adds up.
  places     Json     @default("[]")
  batchNo    String?
  expiry     DateTime?
  // The label the goods physically arrived carrying. Kept on the document so a
  // claim can be tied to the exact consignment, and registered as an ItemCode.
  mfrCode    String?
}

model VendorPayment {
  id       String   @id @default(cuid())
  vendorId String
  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  date     DateTime
  amount   Decimal  @db.Decimal(14, 2)
  ref      String   @default("")
  // Set when this leg was settled by a customer paying the supplier directly.
  // The supplier is never told whose money it was.
  settlementId String?     @unique
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
}

enum TransferStatus {
  IN_TRANSIT
  RECEIVED
}

model Transfer {
  id         String         @id // TRF-2201
  itemId     String
  item       Item           @relation(fields: [itemId], references: [id])
  fromId     String
  from       Godown         @relation("TransferFrom", fields: [fromId], references: [id])
  toId       String
  to         Godown         @relation("TransferTo", fields: [toId], references: [id])
  qty        Int
  batchNo    String?
  status     TransferStatus @default(IN_TRANSIT)
  by         String
  at         DateTime       @default(now())
  receivedAt DateTime?
}

// ───────────────────────── Orders ─────────────────────────

enum OrderStatus {
  BOOKED
  APPROVED
  RESERVED
  ALLOCATED
  PICKING
  PICKED
  PACKED
  READY_TO_DISPATCH
  PARTIALLY_DISPATCHED
  DISPATCHED
  DELIVERED
  LAPSED
  REJECTED
  CANCELLED
}

model Order {
  id         String      @id // ORD-1061
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(BOOKED)
  subtotal   Decimal     @db.Decimal(14, 2)
  tax        Decimal     @db.Decimal(14, 2)
  total      Decimal     @db.Decimal(14, 2)
  requiredBy DateTime
  holdUntil  DateTime?
  approvedAt DateTime?
  bookedBy   String
  source     String      @default("portal")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  lines      OrderLine[]
  events     OrderEvent[]
  dispatches Dispatch[]
  invoices   Invoice[]
  returns    ReturnRequest[]

  @@index([customerId, createdAt])
  @@index([status, holdUntil])
}

model OrderLine {
  id       String       @id @default(cuid())
  orderId  String
  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item         @relation(fields: [itemId], references: [id])
  lineId   String
  line     BusinessLine @relation(fields: [lineId], references: [id])
  qty      Int
  rate     Decimal      @db.Decimal(12, 2) // snapshot — never recalculated
  slabRate Decimal      @db.Decimal(12, 2)
  mult     Decimal      @db.Decimal(6, 3)
  priceSrc String       @default("slab")
  amount   Decimal      @db.Decimal(14, 2)
  gstPct   Int
  hsn      String
  alloc    Json         @default("{}") // { godownId: qty }
  shipped  Int          @default(0)
}

model OrderEvent {
  id      String   @id @default(cuid())
  orderId String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from    String?
  to      String
  by      String
  why     String   @default("")
  at      DateTime @default(now())
}

// How a consignment left the building.
//
// A transport company gives an LR number and the goods travel on a lorry. A
// great deal of Bikaner's trade does not: a bundle is handed to the conductor
// of the evening bus, and what the customer needs is the bus number, the
// driver's phone, a photograph of the bundle actually on it, and the time it
// left. There is no LR to quote and nobody to chase, so the photographs and the
// number ARE the consignment note — which is why they are recorded here rather
// than left to a WhatsApp thread nobody can find a week later.
enum DispatchMode {
  TRANSPORT
  BUS
}

model Dispatch {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  mode        DispatchMode @default(TRANSPORT)
  transporter String
  lr          String
  tracking    String   @default("")
  packages    Int      @default(1)
  freight     Decimal  @default(0) @db.Decimal(12, 2)
  ewb         String?
  // Bus consignments only.
  busNo       String   @default("")
  driverPhone String   @default("")
  loadedAt    DateTime?
  photos      Json     @default("[]") // [url]
  lines       Json     @default("[]") // [{ itemId, qty, godownId }]
  invoiceNo   String?
  at          DateTime @default(now())
  by          String

  shares      DispatchShare[]
}

// Records that the dispatch note was sent from here, to a number somebody
// chose — the same thing InvoiceShare records for a bill, and named the same
// way: sent from here, not delivered. WhatsApp does not tell us the rest.
model DispatchShare {
  id         String   @id @default(cuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  channel    String   @default("WHATSAPP")
  toName     String   @default("")
  toPhone    String
  by         String
  at         DateTime @default(now())

  @@index([dispatchId, at])
}

model Invoice {
  no         String   @id // VC/26-27/0412
  // The line this invoice bills for, copied from the order at the moment it is
  // raised. An order is confined to one business line, so this is unambiguous,
  // and it is stored rather than joined so the invoice register can be filtered
  // by line without walking every order line.
  lineId     String?
  line       BusinessLine? @relation(fields: [lineId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  date       DateTime @default(now())
  taxable    Decimal  @db.Decimal(14, 2)
  cgst       Decimal  @db.Decimal(14, 2)
  sgst       Decimal  @db.Decimal(14, 2)
  igst       Decimal  @db.Decimal(14, 2)
  total      Decimal  @db.Decimal(14, 2)
  blocks     Json     @default("[]")
  status     String   @default("Posted") // Posted | Cancelled (number never reused)
  lines      InvoiceLine[]
  shares     InvoiceShare[]
  amendments InvoiceAmendment[]

  @@index([customerId, date])
  @@index([lineId, date])
}

// A correction made to a bill after it was raised.
//
// A tax invoice is not an ordinary record: the number is filed, the ledger is
// posted from it and the GST return is built out of it. So a correction is
// never a silent overwrite — the bill carries how many times it was corrected,
// what it said before, who changed it and why, and the ledger is put right with
// a fresh entry rather than by editing the one already there. The number itself
// never changes and is never reused.
model InvoiceAmendment {
  id        String   @id @default(cuid())
  invoiceNo String
  invoice   Invoice  @relation(fields: [invoiceNo], references: [no], onDelete: Cascade)
  reason    String
  oldTotal  Decimal  @db.Decimal(14, 2)
  newTotal  Decimal  @db.Decimal(14, 2)
  // What each line said before and after: [{ sku, was: {qty, rate}, now: {qty, rate} }]
  detail    Json     @default("[]")
  by        String
  at        DateTime @default(now())

  @@index([invoiceNo, at])
}

// Every time a bill was sent out, to whom and by whom. A bill goes more than
// once — the first copy, then a reminder to accounts a fortnight later — so
// this is a trail rather than a flag on the invoice.
//
// Honest about what it knows: the office opens the message ready-addressed and
// presses send in WhatsApp itself. We record that it was sent from here, to
// this number. We cannot see WhatsApp's delivery or read receipts, so nothing
// here claims the customer received it.
model InvoiceShare {
  id        String   @id @default(cuid())
  invoiceNo String
  invoice   Invoice  @relation(fields: [invoiceNo], references: [no], onDelete: Cascade)
  channel   String   @default("WHATSAPP")
  toName    String   @default("")
  toPhone   String
  by        String
  at        DateTime @default(now())

  @@index([invoiceNo, at])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceNo String
  invoice   Invoice @relation(fields: [invoiceNo], references: [no], onDelete: Cascade)
  itemId    String
  itemName  String
  sku       String
  hsn       String
  qty       Int
  rate      Decimal @db.Decimal(12, 2)
  amount    Decimal @db.Decimal(14, 2)
  gstPct    Int
}

// ───────────────────────── Ledger ─────────────────────────

enum LedgerType {
  OPENING
  INVOICE
  PAYMENT
  CREDIT
}

// The only source of truth for outstanding. No screen stores or edits a balance.
model LedgerEntry {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  date       DateTime
  type       LedgerType
  ref        String
  particular String
  debit      Decimal    @default(0) @db.Decimal(14, 2)
  credit     Decimal    @default(0) @db.Decimal(14, 2)
  createdAt  DateTime   @default(now())

  @@index([customerId, date])
}

model Payment {
  id         String   @id // RCPT-3300
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  // Carries the time as well as the day. Two UPI transfers of the same amount
  // from the same firm on one afternoon are told apart by the clock and by
  // nothing else, and "which of these two is the one he is asking about" is a
  // question the counter gets.
  date       DateTime
  amount     Decimal  @db.Decimal(14, 2)
  method     String
  ref        String   @default("")
  // The screenshot the customer sent. A UPI reference typed off a phone screen
  // is wrong often enough that the picture is the evidence, not the note.
  proofUrl   String?
  // Set when this money never passed through our account — see Settlement.
  settlementId String?    @unique
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  by         String
  createdAt  DateTime @default(now())
}

// Money that went straight from a customer to one of our suppliers.
//
// The firm owes us, we owe a supplier, and rather than the money making two
// journeys it makes one: the customer is given a QR and pays the supplier
// directly, against his own bill with us. Both ledgers have to move — his
// outstanding falls and our payable falls — off a single act.
//
// Neither side is told about the other. The customer's statement says a payment
// was received and nothing more; the supplier's payment carries this reference
// and no customer. `id` is ours, and the only thing both legs have in common,
// so a year from now the two entries can still be put back together.
//
// One caveat the software cannot fix: a UPI QR carries the payee's name, so the
// customer will see who he is paying inside his own UPI app. What is controlled
// here is what this system discloses and what the paperwork says.
model Settlement {
  id             String   @id // STL-0001
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  amount         Decimal  @db.Decimal(14, 2)
  at             DateTime @default(now())
  note           String   @default("")
  by             String

  payment        Payment?
  vendorPayment  VendorPayment?

  @@index([customerId, at])
  @@index([vendorId, at])
}

// ───────────────────────── Returns, Job work ─────────────────────────

enum ReturnStatus {
  REQUESTED
  INSPECTION
  ACCEPTED
  REJECTED
}

model ReturnRequest {
  id           String       @id // RET-3101
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id])
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id])
  itemId       String
  item         Item         @relation(fields: [itemId], references: [id])
  qty          Int
  reason       String
  hasPhoto     Boolean      @default(false)
  status       ReturnStatus @default(REQUESTED)
  outcome      String?      // Good stock | Damaged | Rejected
  note         String?
  godownId     String?
  creditAmount Decimal?     @db.Decimal(14, 2)
  creditNoteNo String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
}

enum JobStatus {
  ENQUIRY
  QUOTED
  ACCEPTED
  PROOF_SENT
  APPROVED_PROOF
  PRINTING
  QC
  READY
  DELIVERED
}

model JobWork {
  id            String    @id // JOB-5101
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  baseItemId    String
  baseItem      Item      @relation("JobBase", fields: [baseItemId], references: [id])
  processItemId String
  processItem   Item      @relation("JobProcess", fields: [processItemId], references: [id])
  qty           Int
  status        JobStatus @default(QUOTED)
  requiredBy    DateTime
  text          String
  quote         Decimal   @db.Decimal(14, 2)
  proofs        Int       @default(0)
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ───────────────────────── Portal: kits, cart, referrals, ads ─────────────────────────

model KitVersion {
  id       String           @id // KIT-2026-S2
  name     String
  issuedAt DateTime         @default(now())
  items    KitVersionItem[]
  kits     Kit[]
}

model KitVersionItem {
  kitVersionId String
  kitVersion   KitVersion @relation(fields: [kitVersionId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id])

  @@id([kitVersionId, itemId])
}

model Kit {
  customerId   String     @id
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kitVersionId String
  kitVersion   KitVersion @relation(fields: [kitVersionId], references: [id])
  issuedAt     DateTime
  lastScanAt   DateTime?
  session      Json?      // { scans: string[], last, startedAt, pending }
}

// Chasing a basket somebody filled and walked away from. One row per attempt,
// because two executives ringing the same firm on the same afternoon is worse
// than nobody ringing at all — the screen has to be able to say "already done,
// by her, on Tuesday".
//
// The basket's value is copied in at the moment of the chase. A basket changes
// after it is chased, and "what was it worth when we rang" is the question that
// makes the follow-up worth measuring.
model CartRecovery {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String   @default("WHATSAPP") // WHATSAPP | CALL | NOTE
  toName     String   @default("")
  toPhone    String   @default("")
  note       String   @default("")
  cartValue  Decimal  @default(0) @db.Decimal(14, 2)
  cartCount  Int      @default(0)
  by         String
  at         DateTime @default(now())

  @@index([customerId, at])
}

model Cart {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines      Json     @default("[]") // [{ itemId, qty }]
  updatedAt  DateTime @updatedAt
}

model Referral {
  id        String   @id // REF-01
  byId      String
  by        Customer @relation(fields: [byId], references: [id])
  name      String
  tehsil    String
  phone     String
  address   String   @default("")
  state     String   @default("Submitted")
  reward    Decimal  @default(2000) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  // The firm this referral turned into, once it signs up. Set when the office
  // opens the account with the referrer's code in hand. Until this existed the
  // report matched referral to firm on the name as typed, which missed every
  // firm written down slightly differently from how it was registered.
  customerId String?  @unique
  customer   Customer? @relation("ReferredCustomer", fields: [customerId], references: [id], onDelete: SetNull)
}

// What the portal shows above the catalogue. Text-only and seeded-only until
// now; the office can write these and put a picture on them, which is what a
// season's range actually needs — a retailer buys a card by looking at it.
model Ad {
  id          String  @id @default(cuid())
  title       String
  sub         String
  imageUrl    String?
  // Machine-based targeting, as before: { machine } or { noMachine }.
  target      Json    @default("{}")
  // Shown only to firms who deal in this line, when set. A flex banner has no
  // business on a card retailer's home screen.
  lineId      String?
  line        BusinessLine? @relation(fields: [lineId], references: [id])
  // Where tapping it goes: an item, or nothing.
  itemId      String?
  item        Item?   @relation(fields: [itemId], references: [id])
  // A season's banner has a beginning and an end; both optional.
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  impressions Int     @default(0)
  taps        Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// "What customers searched for and could not get" — the stock-out demand report.
model StockoutSearch {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  reqQty     Int
  availQty   Int
  at         DateTime @default(now())
  // The firm asked to be told when this comes back. Every short search is
  // already recorded here for the demand report; this marks the ones where
  // somebody actually wants a call, and when that call was raised, so it is
  // raised once and not every time the sweeper looks.
  notifyWanted Boolean  @default(false)
  notifiedAt   DateTime?

  @@index([itemId, at])
  @@index([notifyWanted, notifiedAt])
}
